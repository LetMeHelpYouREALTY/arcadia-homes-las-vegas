{
  "name": "arcadia-homes-las-vegas-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lhci autorun",
    "lighthouse:manual": "lighthouse https://www.arcadiahomeslasvegas.com --view --preset=desktop",
    "perf": "npm run analyze && npm run lighthouse",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel deploy --prebuilt",
    "vercel:prod": "vercel deploy --prod --prebuilt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@marsidev/react-turnstile": "^1.4.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@sentry/nextjs": "^10.38.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "geist": "^1.2.2",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "openai": "^4.28.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.11.24",
    "@types/react": "18.2.63",
    "@types/react-dom": "18.2.20",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "3.4.1",
    "typescript": "5.4.2",
    "vitest": "^4.0.18",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
